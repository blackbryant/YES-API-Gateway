# 複製為 simulation/.env 後使用（.env 不納入版控）；僅供模擬環境，請勿用於正式環境
# postgres 與閘道容器共用此檔：postgres 以 POSTGRES_* 建立帳號與資料庫，閘道以相同值組出連線字串
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yes_gateway
POSTGRES_USER=yesuser
POSTGRES_PASSWORD=sim_password

# JWT HS256 簽章密鑰（UTF-8 至少 32 bytes）；多節點必須相同
AUTH_TOKEN_SECRET=simulation-only-signing-key-change-me-0123456789

# 初始管理者（首次登入須變更密碼）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# ---- 以下只給 docker compose 使用 ----
# 對本機開放的埠
GATEWAY_PORT=8080
POSTGRES_HOST_PORT=5433
# Development 會開啟 Swagger（/swagger）
GATEWAY_ENVIRONMENT=Development
