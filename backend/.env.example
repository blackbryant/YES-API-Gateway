# 複製為 backend/.env 後填入實際值
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yes_gateway
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT HS256 簽章密鑰（UTF-8 至少 32 bytes）；產生：openssl rand -base64 48
AUTH_TOKEN_SECRET=

# 初始管理者（僅在資料庫尚無任何使用者時建立，首次登入須變更密碼）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

APP_ORIGIN=http://localhost:3000
APP_PORT=8080
